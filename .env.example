# Application
APP_NAME=Distributed Web Crawler
DEBUG=False

# Database
DATABASE_URL=postgresql://crawler_user:crawler_password@localhost:5432/crawler_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_SOFT_TIME_LIMIT=300
CELERY_TASK_TIME_LIMIT=360

# Crawler Configuration
CRAWLER_USER_AGENT=DistributedCrawler/1.0 (+https://example.com/bot)
CRAWLER_DEFAULT_TIMEOUT=30
CRAWLER_MAX_DEPTH=3
CRAWLER_MAX_PAGES=100
CRAWLER_RESPECT_ROBOTS=True
CRAWLER_RATE_LIMIT_PER_DOMAIN=1.0

# Retry Configuration
RETRY_MAX_ATTEMPTS=5
RETRY_BACKOFF_BASE=60
RETRY_BACKOFF_MAX=600

# Dead Letter Queue
DLQ_ENABLED=True
DLQ_ALERT_WEBHOOK=
