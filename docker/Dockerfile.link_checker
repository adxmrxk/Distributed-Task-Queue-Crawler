# ---- build stage ----
FROM golang:1.22-alpine AS builder

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN go build -o link_checker .

# ---- runtime stage ----
FROM alpine:3.19

# ca-certificates needed for HTTPS requests
RUN apk add --no-cache ca-certificates

WORKDIR /app
COPY --from=builder /app/link_checker .

CMD ["./link_checker"]
